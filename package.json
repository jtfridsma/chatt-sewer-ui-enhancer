{
  "name": "chatt-sewer-ui-enhancer",
  "version": "0.1.0",
  "type": "module",
  "description": "Restyles the Chattanooga sewer payments portal and related dashboard to match the main Chattanooga.gov UI more closely.",
  "keywords": [],
  "author": "jtf",
  "license": "UNLICENSED",
  "scripts": {
    "build:css": "sass src/styles/main.scss public/main.css --no-source-map --style=compressed",
    "build:js": "node build.mjs",
    "build": "npm-run-all build:*",
    "dev:css": "sass --watch src/styles/main.scss public/main.css --no-source-map",
    "dev:js": "node build.mjs --watch",
    "dev": "npm-run-all --parallel dev:css dev:js",
    "lint": "prettier --check .",
    "test": "node --test",
    "format": "prettier --write .",
    "prebuild": "npm run lint && npm test"
  },
  "devDependencies": {
    "esbuild": "^0.27.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.6.2",
    "sass": "^1.94.2"
  },
  "dependencies": {
    "chart.js": "^4.5.1"
  }
}
